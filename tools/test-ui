  for old,new in {'#141618':'#fcfcfc','#272b2e':'#ffffff','#202427':'#eff0f1','#24292d':'#e3e5e7','#eff0f1':'#232629','#b9c0c6':'#586169','#929ba2':'#626b73','#d8323a':'#a3161f','#373e44':'#d5dce1','#30373c':'#e4e8ea','#43484c':'#c6cbd0'}.items():
   harness=harness.replace('COLOR'+old[1:],new)
 import json
 if args.capture: args.capture.mkdir(parents=True,exist_ok=True)
 harness=harness.replace('CAPTURE_DIRECTORY', json.dumps(str(args.capture.resolve()) if args.capture else ""))
 (d/'harness.qml').write_text(harness)
 engine.load(QUrl.fromLocalFile(str(d/'harness.qml')))
 if engine.rootObjects():
  QTimer.singleShot(5000,app.quit);app.exec()
 passed='IMPORT_UI_PASS' in messages
 warnings=[m for m in messages if m!='IMPORT_UI_PASS']
