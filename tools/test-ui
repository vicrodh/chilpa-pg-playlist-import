 AlbumDetailModel { id: recordModel; selectedId: -1; title: "An album with a long title" }
 SourcePageHeader { playbackModel: playModel; parent:scene; id: artistHeader; visible:false; width:scene.width; currentPage:true; info:({kind:"artist",title:"Artist",plugin:"source-a",description:"Biography",ref:"artist:1"}) }
