#!/usr/bin/env python3
"""Build the native plugin for this machine and package its executable."""
import hashlib
import json
import pathlib
import shutil
import subprocess
import sys
import zipfile

root = pathlib.Path(__file__).resolve().parents[1]
manifest = json.loads((root / "manifest.json").read_text())
metadata = json.loads(subprocess.check_output(
    ["cargo", "metadata", "--format-version", "1", "--no-deps", "--locked"], cwd=root))
triple = next(line.split(": ", 1)[1] for line in subprocess.check_output(
    ["rustc", "-vV"], text=True).splitlines() if line.startswith("host: "))
subprocess.run(["cargo", "build", "--locked", "--release", "--target", triple,
                "-p", "chilpa-pg-playlist-import", "--bin", "plugin"], cwd=root, check=True)

executable = "plugin.exe" if sys.platform == "win32" else "plugin"
source = pathlib.Path(metadata["target_directory"]) / triple / "release" / executable
folder = root / "dist" / f'{manifest["version"]}-{triple}'
folder.mkdir(parents=True, exist_ok=True)
shutil.copy2(source, folder / executable)
names = (executable, "manifest.json", "COPYING", "NOTICE")
for name in names[1:]:
    shutil.copy2(root / name, folder / name)
archive = folder.parent / f"{folder.name}.zip"
with zipfile.ZipFile(archive, "w", compression=zipfile.ZIP_DEFLATED) as package:
    for path in (folder / name for name in names):
        package.write(path, path.name)
for path in (folder / executable, archive):
    print(f"{path}\nSHA256 {hashlib.sha256(path.read_bytes()).hexdigest()}")
